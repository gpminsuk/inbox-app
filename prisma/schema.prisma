// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  emailPermissionLevel String    @default("read-only") // Options: "read-only" or "modify-compose"
  accounts            Account[]
  sessions            Session[]
  inboxEntries        InboxEntry[]
  logs                Log[]     // Relation to logs created by this user's account
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Inbox App Models
model InboxEntry {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  actions   Action[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Action {
  id           String     @id @default(cuid())
  description  String
  completed    Boolean    @default(false)
  dueDate      DateTime?
  inboxEntryId String
  inboxEntry   InboxEntry @relation(fields: [inboxEntryId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// Log model for storing agent activity logs
model Log {
  id        String   @id @default(cuid())
  message   String   @db.Text
  level     String   @default("info") // info, warning, error
  source    String   @default("email-processor") // The source of the log (email-processor, etc.)
  timestamp DateTime @default(now())
  userId    String?  // Optional relation to user if the log is associated with a specific user
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([timestamp])
  @@index([userId])
  @@index([source])
}
